# Copy to .env.local for local testing, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# Required: the account that sends the contact-form emails.
# For Gmail, SMTP_PASS is a 16-character App Password (not your normal password):
# https://myaccount.google.com/apppasswords
SMTP_USER=tanmaysraghuvanshi23@gmail.com
SMTP_PASS=

# Optional: only needed if you're not using Gmail (e.g. smtp.resend.com, smtp-relay.brevo.com).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional: where messages are delivered, and the sender address. Both default to SMTP_USER.
# CONTACT_TO=
# CONTACT_FROM=

# Optional: the public URL, used for link previews and the sitemap.
# Not needed on Vercel (it's detected automatically); set it on other hosts or for a custom domain.
# SITE_URL=https://your-domain.com
